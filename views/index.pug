extends layout.pug

block content

  article.portfolio-intro

    h1 My Portfolio
    p It showcases my projects


  article.portfolio-project-thumbs
    .projects-box.box.grid

      each item in projects
        .cell
          a(href=`/project/${item.id}`)
            img.thumbnail(src=`/${item.image_urls[0]}`, alt=`${item.project_name}`)
            h5= item.project_name

